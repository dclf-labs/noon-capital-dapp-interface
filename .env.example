# ═══════════════════════════════════════════════════════════════════════════════
# Noon Capital DApp — environment template
# ═══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env
#
# Rules
#   • Never commit `.env` (gitignored). Only this example file is checked in.
#   • Every `VITE_*` value is embedded in the client bundle — treat as public.
#   • Prefer the canonical names below. Alternate `VITE_APP_*` keys are also
#     accepted via src/lib/env (listed at the bottom of this file).
#   • App code reads `appEnv` from `src/lib/env`, not `import.meta.env` directly.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Required for a working app ────────────────────────────────────────────────
# Noon backend API (trailing slash optional; stripped at runtime)
VITE_API_BASE_URL=https://back.noon.capital

# Reown / WalletConnect Cloud project id — REQUIRED in production / deploys.
# Create one at https://dashboard.reown.com
# Empty in production fails closed at AppKit bootstrap.
VITE_WALLETCONNECT_PROJECT_ID=

# Starknet Infura API key (builds mainnet RPC). Or set VITE_STARKNET_RPC_URL instead.
VITE_STARKNET_INFURA_API_KEY=

# ─── Optional RPC overrides ────────────────────────────────────────────────────
# Leave blank to use public defaults in protocol chain config.
# Explicit URL wins. Useful under load / for Infura/Ankr paid endpoints.
VITE_STARKNET_RPC_URL=
VITE_ETHEREUM_RPC_URL=
VITE_BASE_RPC_URL=
VITE_SUI_RPC_URL=
VITE_TAC_RPC_URL=
VITE_ZKSYNC_RPC_URL=
VITE_SOPHON_RPC_URL=
VITE_BERACHAIN_RPC_URL=
VITE_CITREA_RPC_URL=
VITE_HYPEREVM_RPC_URL=
VITE_MONAD_RPC_URL=

# ─── Optional analytics ────────────────────────────────────────────────────────
# Google Analytics measurement id (G-…). Injected into index.html only.
# Leave empty to disable. Skipped on localhost.
VITE_GA_MEASUREMENT_ID=

# ─── Alternate env key names (optional) ────────────────────────────────────────
# Still accepted by src/lib/env. Prefer canonical names above.
#
#   VITE_APP_API_BASE_URL              → VITE_API_BASE_URL
#   VITE_APP_WALLET_CONNECT_PROJECT_ID → VITE_WALLETCONNECT_PROJECT_ID
#   VITE_STARKNET_ALCHEMY_API_KEY      → VITE_STARKNET_INFURA_API_KEY (legacy name)
#   VITE_APP_STARKNET_ALCHEMY_API_KEY  → VITE_STARKNET_INFURA_API_KEY (legacy name)
