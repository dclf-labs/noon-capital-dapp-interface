# ═══════════════════════════════════════════════════════════════════════════════
# Noon Capital DApp — environment template
# ═══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env
#
# Rules
#   • Never commit `.env` (gitignored). Only this example file is checked in.
#   • Every `VITE_*` value is embedded in the client bundle — treat as public.
#   • Prefer these canonical names. Legacy aliases still work (see bottom + src/lib/env).
#   • App code reads `appEnv` from `src/lib/env`, not `import.meta.env` directly.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── App ───────────────────────────────────────────────────────────────────────
# App stage (distinct from Vite MODE): development | staging | production
VITE_APP_ENV=development

# Noon backend API (trailing slash optional; stripped at runtime)
# Used by points, username, protocol stats, mint/redeem API routes, etc.
VITE_API_BASE_URL=https://back.noon.capital

# ─── Wallets ───────────────────────────────────────────────────────────────────
# Reown / WalletConnect Cloud project id — REQUIRED in production / deploys.
# Create one at https://dashboard.reown.com
# Empty in production fails closed at AppKit bootstrap.
VITE_WALLETCONNECT_PROJECT_ID=

# ─── Analytics (optional) ──────────────────────────────────────────────────────
# Google Analytics measurement id (G-…). Injected into index.html only.
# Leave empty to disable. Skipped on localhost.
VITE_GA_MEASUREMENT_ID=

# Mixpanel project token (reserved for analytics wiring)
VITE_MIXPANEL_TOKEN=

# ─── RPCs (optional) ───────────────────────────────────────────────────────────
# Explicit URLs win. Leave blank to use built-in defaults / protocol config.
#
# Starknet resolution order:
#   1. VITE_STARKNET_RPC_URL
#   2. Alchemy URL built from VITE_STARKNET_ALCHEMY_API_KEY
#   3. Public Blast endpoint
VITE_STARKNET_RPC_URL=
VITE_STARKNET_ALCHEMY_API_KEY=

# Sui: if empty → protocol config RPC, else Mysten mainnet fullnode
VITE_SUI_RPC_URL=

# ─── Subgraphs — Goldsky holdings ──────────────────────────────────────────────
# Mapped via protocol `holdingsSubgraphChain` → appEnv.subgraphs.holdings
# Leave blank when a chain's holdings UI is unused locally.

# Ethereum
VITE_SUBGRAPH_USN_ETHEREUM_URL=
VITE_SUBGRAPH_SUSN_ETHEREUM_URL=

# Sophon
VITE_SUBGRAPH_USN_SOPHON_URL=
VITE_SUBGRAPH_SUSN_SOPHON_URL=

# zkSync
VITE_SUBGRAPH_USN_ZKSYNC_URL=
VITE_SUBGRAPH_SUSN_ZKSYNC_URL=

# TAC
VITE_SUBGRAPH_USN_TAC_URL=
VITE_SUBGRAPH_SUSN_TAC_URL=

# Aggregated Ethereum meta subgraph
VITE_SUBGRAPH_ETH_META_URL=

# ─── Legacy aliases (optional — do not use for new setups) ─────────────────────
# Still accepted by src/lib/env during migration. Prefer canonical names above.
#
#   VITE_APP_API_BASE_URL              → VITE_API_BASE_URL
#   VITE_APP_WALLET_CONNECT_PROJECT_ID → VITE_WALLETCONNECT_PROJECT_ID
#   VITE_APP_MIXPANEL_TOKEN            → VITE_MIXPANEL_TOKEN
#   VITE_APP_STARKNET_ALCHEMY_API_KEY  → VITE_STARKNET_ALCHEMY_API_KEY
#   VITE_APP_GOLDSKY_USN_MAINNET_URL   → VITE_SUBGRAPH_USN_ETHEREUM_URL
#   VITE_APP_GOLDSKY_SUSN_MAINNET_URL  → VITE_SUBGRAPH_SUSN_ETHEREUM_URL
#   VITE_APP_GOLDSKY_USN_SOPHON_URL    → VITE_SUBGRAPH_USN_SOPHON_URL
#   VITE_APP_GOLDSKY_SUSN_SOPHON_URL   → VITE_SUBGRAPH_SUSN_SOPHON_URL
#   VITE_APP_GOLDSKY_USN_ZKSYNC_URL    → VITE_SUBGRAPH_USN_ZKSYNC_URL
#   VITE_APP_GOLDSKY_SUSN_ZKSYNC_URL   → VITE_SUBGRAPH_SUSN_ZKSYNC_URL
#   VITE_APP_GOLDSKY_USN_TAC_URL       → VITE_SUBGRAPH_USN_TAC_URL
#   VITE_APP_GOLDSKY_SUSN_TAC_URL      → VITE_SUBGRAPH_SUSN_TAC_URL
#   VITE_APP_ETH_META_SUBGRAPH_URL     → VITE_SUBGRAPH_ETH_META_URL
