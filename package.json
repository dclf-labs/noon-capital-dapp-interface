{
  "name": "noon-capital-dapp-interface",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "axios": "^1.18.1",
    "ws": "^8.21.0",
    "lit": "3.3.3",
    "lit-html": "3.3.3",
    "lit-element": "4.2.2",
    "@lit/reactive-element": "2.1.2"
  },
  "resolutions": {
    "lit": "3.3.3",
    "lit-html": "3.3.3",
    "lit-element": "4.2.2",
    "@lit/reactive-element": "2.1.2"
  },
  "pnpm": {
    "publicHoistPattern": [
      "*vite*",
      "*eslint*",
      "*prettier*",
      "@types*"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "prettier --check . && eslint . && vitest run && tsc -b && vite build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@layerzerolabs/lz-definitions": "^3.1.7",
    "@layerzerolabs/lz-sui-oft-sdk-v2": "^3.0.168",
    "@layerzerolabs/lz-sui-sdk-v2": "^3.0.168",
    "@layerzerolabs/lz-v2-utilities": "^3.0.168",
    "@mysten/dapp-kit-react": "^2.1.14",
    "@mysten/sui": "^2.23.1",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@starknet-react/chains": "^5.0.3",
    "@starknet-react/core": "^5.0.3",
    "@tanstack/react-query": "^5.101.4",
    "@uniswap/permit2-sdk": "^1.4.0",
    "@wagmi/core": "^3.6.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "ethers": "^6.17.0",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "moment": "^2.30.1",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-number-format": "^5.4.4",
    "react-router-dom": "^7.18.2",
    "starknet": "^10.0.2",
    "starknetkit": "^3.4.3",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.55.10",
    "wagmi": "^3.7.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
